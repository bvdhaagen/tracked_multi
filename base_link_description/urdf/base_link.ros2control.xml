<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ros2_control hardware description for the tank base.

    By default this loads "fake"/mock hardware (mock_components/GenericSystem),
    which makes every commanded joint perfectly echo its command back as state.
    That lets the whole controller stack (diff_drive + joint_state_broadcaster)
    run with NO real motors and NO physics engine - ideal for simulation,
    RViz driving and CI.

    Set use_mock_hardware:=false to instead bind to the Gazebo Sim
    (gz_ros2_control) plugin for full physics.

    All 12 wheels (2 drive + 4 idle per side) are exposed so the whole running
    gear spins at the same speed, matching the Gazebo setup.
  -->
  <xacro:macro name="base_link_ros2_control" params="name:=TankSystem use_mock_hardware:=true">

    <!-- Only emit a ros2_control block for the mock (RViz) path. In Gazebo the
         robot is driven by the built-in Ignition DiffDrive plugin instead, so
         no ros2_control hardware is needed there. -->
    <xacro:if value="${use_mock_hardware}">
    <ros2_control name="${name}" type="system">

      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <!-- integrate velocity commands into a position state so odometry works -->
        <param name="calculate_dynamics">true</param>
      </hardware>

      <!-- ===== LEFT TRACK DRIVE WHEELS ===== -->
      <joint name="Revolute 11">   <!-- left_front_wheel_v2_1 -->
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Revolute 22">   <!-- left_back_wheel_v2_1 -->
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- ===== RIGHT TRACK DRIVE WHEELS ===== -->
      <joint name="Revolute 10">   <!-- right_front_wheel_v2_1 -->
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Revolute 8">    <!-- right_back_wheel_v2_1 -->
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- ===== LEFT IDLE / ROAD WHEELS ===== -->
      <joint name="Revolute 14">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Revolute 15">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Revolute 16">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Revolute 17">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- ===== RIGHT IDLE / ROAD WHEELS ===== -->
      <joint name="Revolute 18">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Revolute 19">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Revolute 20">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Revolute 21">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>
    </xacro:if>
  </xacro:macro>
</robot>
