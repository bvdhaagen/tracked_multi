  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_track_v2_1">
  <material>${body_color}</material>
  <mu1>0.05</mu1>
  <mu2>0.05</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_track_v3_1">
  <material>${body_color}</material>
  <mu1>0.05</mu1>
  <mu2>0.05</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_glide_wheel_1_v2_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_glide_wheel_2_v2_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_glide_wheel_3_v2_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_glide_wheel_4_v2_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_glide_wheel_1_v2_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_glide_wheel_2_v2_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_glide_wheel_3_v2_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_glide_wheel_4_v2_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_back_wheel_v2_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<!-- ================= Gazebo (Ignition Fortress) drive ================= -->
<!-- Only active for the physics path (use_mock_hardware:=false). Drives the
     tank from /cmd_vel using Gazebo's built-in DiffDrive plugin and publishes
     odom + TF + joint states (bridged to ROS via ros_gz_bridge). -->
<xacro:unless value="$(arg use_mock_hardware)">
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <!-- left side -->
      <left_joint>Revolute 11</left_joint>
      <left_joint>Revolute 22</left_joint>
      <!-- right side -->
      <right_joint>Revolute 10</right_joint>
      <right_joint>Revolute 8</right_joint>

      <wheel_separation>0.89</wheel_separation>
      <wheel_radius>0.2</wheel_radius>

      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- This is a TRACKED tank: the ground contact is the fixed track/hull, and
         the drive sprockets float ~0.18 m above the ground, so wheel friction
         alone cannot propel it. VelocityControl applies the /cmd_vel twist to
         the body directly (in the robot frame), guaranteeing the tank drives
         and turns. DiffDrive above still spins the wheels and publishes
         odom/TF, which stays consistent because both use the same
         wheel_radius/wheel_separation. -->
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl">
      <topic>cmd_vel</topic>
    </plugin>

    <!-- publish joint angles so the wheels visibly spin in RViz -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
    </plugin>
  </gazebo>
</xacro:unless>

</robot>
